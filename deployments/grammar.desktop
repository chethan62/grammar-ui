[Desktop Entry]
Type=Application
Name=Grammar
GenericName=Writing checker
Comment=Check and rewrite your writing against the local engine
Exec=env GTK_THEME=Adwaita:dark @BINDIR@/grammar
Icon=grammar-ui
Terminal=false
Categories=Utility;TextTools;
Keywords=grammar;spelling;writing;check;rewrite;
StartupNotify=true
StartupWMClass=grammar
