[Unit]
Description=grammar-ui (static UI for grammar-server)
# Soft dependency: the UI is useless without the server, but it serves files either
# way, and Wants does not fail the unit when grammar-server is not installed.
Wants=grammar-server.service
After=network.target grammar-server.service

[Service]
Type=simple
# Static files only. python3's stdlib server is the whole web server — no framework,
# no build step, no dependency to keep patched. /usr/bin/env so the unit does not
# hardcode a distribution's python path.
ExecStart=/usr/bin/env python3 -m http.server 8899 --bind 127.0.0.1 --directory %h/.local/share/grammar-ui
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
