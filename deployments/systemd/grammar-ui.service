[Unit]
Description=grammar-ui (static UI for grammar-server)
# Soft dependency: the UI is useless without the server, but it serves files either
# way, and Wants does not fail the unit when grammar-server is not installed.
Wants=grammar-server.service
After=network.target grammar-server.service

[Service]
Type=simple
# Static files only. python3's stdlib server is the whole web server — no framework,
# no build step, no dependency to keep patched. /usr/bin/env so the unit does not
# hardcode a distribution's python path.
# --bind :: reaches the LAN *and* its IPv6 side. mDNS gives this machine's name an
# AAAA record (cachyos.local -> 2405:...), and Windows and other IPv6-preferring
# clients go there first, so an IPv4-only bind answers "connection refused" to the
# name while the IPv4 address still works — the one case where typing the name fails.
# Static files that know nothing about your documents, but see grammar-server.service
# for what opening the engine to the LAN means.
ExecStart=/usr/bin/env python3 -m http.server 8899 --bind :: --directory %h/.local/share/grammar-ui
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
